generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}
model Item {
  id        Int      @id @default(autoincrement())
  name      String
  bought    Boolean  @default(false)
  createdAt DateTime @default(now())
}